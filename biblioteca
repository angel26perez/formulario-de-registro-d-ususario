            self._load_table(
                self.current_table
            )


        else:


            self._show_dashboard()


    # ========================================================
    # NUEVO REGISTRO
    # ========================================================


    def _open_new_dialog(self):


        if not self.current_table:


            messagebox.showinfo(
                "Info",
                "Selecciona una tabla primero"
            )


            return


        self._show_crud_dialog(
            "Nuevo registro",
