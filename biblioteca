    # ========================================================
    # OBTENER ESTADÍSTICAS
    # ========================================================


    def _get_dashboard_stats(self):


        stats = {


            "usuarios": 0,


            "libros": 0,


            "autores": 0,


            "prestamos": 0,


            "prestados": 0,


            "disponibles": 0,


            "devueltos": 0,


            "atrasados": 0
        }


        if not self.db.is_connected():
            return stats


        try:


            # ================================================
            # CONSULTAS PRINCIPALES
            # ================================================


            result = self.db.execute_query(
                "SELECT COUNT(*) FROM usuarios"
            )


            stats["usuarios"] = result[0][0]


            result = self.db.execute_query(
                "SELECT COUNT(*) FROM libros"
            )


            stats["libros"] = result[0][0]


            result = self.db.execute_query(
                "SELECT COUNT(*) FROM autores"
            )


            stats["autores"] = result[0][0]


            result = self.db.execute_query(
                "SELECT COUNT(*) FROM prestamos"
            )


            stats["prestamos"] = result[0][0]


            # ================================================
            # PRÉSTAMOS ACTIVOS
            # ================================================


            result = self.db.execute_query(
                """
                SELECT COUNT(*)
                FROM detalle_prestamo dp
                INNER JOIN prestamos p
                    ON dp.id_prestamo = p.id_prestamo
                WHERE p.estado IN ('PRESTADO', 'ATRASADO')
                """
            )


            stats["prestados"] = result[0][0]


            # ================================================
            # LIBROS DISPONIBLES
            # ================================================


            stats["disponibles"] = (
                stats["libros"] -
                stats["prestados"]
            )


            if stats["disponibles"] < 0:
                stats["disponibles"] = 0


            # ================================================
            # DEVUELTOS
            # ================================================


            result = self.db.execute_query(
                """
                SELECT COUNT(*)
                FROM prestamos
                WHERE estado = 'DEVUELTO'
                """
            )


            stats["devueltos"] = result[0][0]


            # ================================================
            # ATRASADOS
            # ================================================


            result = self.db.execute_query(
                """
                SELECT COUNT(*)
                FROM prestamos
                WHERE estado = 'ATRASADO'
                """
            )


            stats["atrasados"] = result[0][0]


        except Error as e:


            logger.error(
                f"Error obteniendo estadísticas: {e}"
            )


        return stats


