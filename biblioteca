        )


    # ========================================================
    # EDITAR
    # ========================================================


    def _open_edit_dialog(self):


        if not self.tree:
            return


        selection = self.tree.selection()


        if not selection:


            messagebox.showinfo(
                "Info",
                "Selecciona un registro para editar"
