    # ========================================================
    # DIÁLOGO CRUD
    # ========================================================


    def _show_crud_dialog(
        self,
        title: str,
        operation: str,
        item: Optional[str] = None
    ):


        dialog = tk.Toplevel(
            self.root
        )


        dialog.title(title)


        dialog.geometry(
            "500x600"
        )


        dialog.configure(
            bg=self.COLORS["bg_dark"]
        )


        dialog.grab_set()


        dialog.transient(
            self.root
        )


        # Canvas
        canvas = tk.Canvas(
            dialog,
            bg=self.COLORS["bg_dark"],
            highlightthickness=0
        )


        scrollbar = ttk.Scrollbar(
            dialog,
            orient=tk.VERTICAL,
            command=canvas.yview
        )


        scroll_frame = tk.Frame(
            canvas,
            bg=self.COLORS["bg_dark"]
        )


        scroll_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(
                scrollregion=canvas.bbox("all")
            )
        )


        canvas.create_window(
            (0, 0),
            window=scroll_frame,
            anchor="nw"
        )


        canvas.configure(
            yscrollcommand=scrollbar.set
        )


        canvas.pack(
            side=tk.LEFT,
            fill=tk.BOTH,
            expand=True,
            padx=10,
            pady=10
        )


        scrollbar.pack(
            side=tk.RIGHT,
            fill=tk.Y
        )


        # Entries
        entries: Dict[str, tk.Entry] = {}


        for idx, col in enumerate(
            self.current_columns
        ):


            label = tk.Label(
                scroll_frame,
                text=col.replace(
                    "_",
                    " "
                ).title(),
                bg=self.COLORS["bg_dark"],
                fg=self.COLORS["text"],
                font=("Segoe UI", 10)
            )


            label.pack(
                pady=(10, 0),
                padx=15,
                anchor="w"
            )


            # ID en CREATE
            if (
                col.endswith("_id")
                and operation == "CREATE"
            ):


                continue


            # ID en UPDATE
            elif col.endswith("_id"):


                entry = tk.Entry(
                    scroll_frame,
                    bg=self.COLORS["bg_lighter"],
                    fg=self.COLORS["text_muted"],
                    font=("Segoe UI", 10),
                    state="readonly"
                )


            else:


                entry = tk.Entry(
                    scroll_frame,
                    bg=self.COLORS["bg_lighter"],
                    fg=self.COLORS["text"],
                    insertbackground=self.COLORS["accent"],
                    font=("Segoe UI", 10)
                )


            entry.pack(
                fill=tk.X,
                padx=15,
                pady=(0, 5)
            )


            entries[col] = entry


        # Cargar datos para editar
        if operation == "UPDATE" and item:


            values = self.tree.item(
                item
            )["values"]


            for idx, col in enumerate(
                self.current_columns
            ):


                if col not in entries:
                    continue


                entry = entries[col]


                if entry["state"] == "readonly":


                    entry.config(
                        state="normal"
                    )


                    entry.insert(
                        0,
                        str(values[idx])
                    )


                    entry.config(
                        state="readonly"
                    )


                else:


                    entry.insert(
                        0,
                        str(values[idx])
                    )


        # Botones
        button_frame = tk.Frame(
            scroll_frame,
            bg=self.COLORS["bg_dark"]
        )


        button_frame.pack(
            fill=tk.X,
            padx=15,
            pady=(20, 10)
        )


        save_btn = tk.Button(
            button_frame,
            text="💾 Guardar",
            command=lambda: self._save_record(
                dialog,
                operation,
                entries
            ),
            bg=self.COLORS["success"],
            fg=self.COLORS["bg_dark"],
            font=("Segoe UI", 10, "bold"),
            relief=tk.FLAT,
            padx=20,
            pady=8,
            cursor="hand2"
        )


        save_btn.pack(
            side=tk.LEFT,
            padx=5
        )


        cancel_btn = tk.Button(
            button_frame,
            text="❌ Cancelar",
            command=dialog.destroy,
            bg=self.COLORS["bg_lighter"],
            fg=self.COLORS["text"],
            font=("Segoe UI", 10),
            relief=tk.FLAT,
            padx=20,
            pady=8,
            cursor="hand2"
        )


        cancel_btn.pack(
            side=tk.LEFT,
            padx=5
        )


    # ========================================================
    # GUARDAR
    # ========================================================


    def _save_record(
        self,
        dialog,
        operation,
        entries
    ):


        try:


            if operation == "CREATE":


                self._insert_record(
                    entries
                )


            elif operation == "UPDATE":


                self._update_record(
                    entries
                )


            messagebox.showinfo(
                "Éxito",
                f"Registro {operation.lower()}do correctamente"
            )


            dialog.destroy()


            # Actualizar tabla
            self._refresh_data()


        except Error as e:


            messagebox.showerror(
                "Error",
                f"Error al guardar:\n{e}"
            )


            self._update_status(
                f"Error: {str(e)}",
                "error"
            )


        except ValueError as e:


            messagebox.showwarning(
                "Advertencia",
                str(e)
            )


    # ========================================================
    # INSERTAR
    # ========================================================


    def _insert_record(
        self,
        entries
    ):


        cols = []


        vals = []


        for col, entry in entries.items():


            value = entry.get().strip()


            if value:


                cols.append(col)


                vals.append(value)


        if not cols:


            raise ValueError(
                "Debe rellenar al menos un campo"
            )


        placeholders = ", ".join(
            ["%s"] * len(cols)
        )


        query = (
            f"INSERT INTO {self.current_table} "
            f"({', '.join(cols)}) "
            f"VALUES ({placeholders})"
        )


        self.db.execute_update(
            query,
            tuple(vals)
        )


        self._update_status(
            f"Registro insertado en '{self.current_table}'",
            "success"
        )


    # ========================================================
    # ACTUALIZAR
    # ========================================================


    def _update_record(
        self,
        entries
    ):


        id_col = next(
            (
                col
                for col in self.current_columns
                if col.endswith("_id")
            ),
            None
        )


        if not id_col:


            raise ValueError(
                "No se encontró columna ID"
            )


        record_id = entries[
            id_col
        ].get()


        updates = []


        vals = []


        for col, entry in entries.items():


            if col == id_col:
                continue


            value = entry.get().strip()


            if value:


                updates.append(
                    f"{col} = %s"
                )


                vals.append(value)


        if not updates:


            raise ValueError(
                "Debe rellenar al menos un campo "
                "para actualizar"
            )


        vals.append(
            record_id
        )


        query = (
            f"UPDATE {self.current_table} "
            f"SET {', '.join(updates)} "
            f"WHERE {id_col} = %s"
        )


        self.db.execute_update(
            query,
            tuple(vals)
        )


        self._update_status(
            f"Registro actualizado en '{self.current_table}'",
            "success"
        )


    # ========================================================
    # ELIMINAR
    # ========================================================


    def _delete_record(self):


        if not self.tree:


            return


        selection = self.tree.selection()


        if not selection:


            messagebox.showinfo(
                "Info",
                "Selecciona un registro para eliminar"
            )


            return


        confirmar = messagebox.askyesno(
            "Confirmar",
            "¿Eliminar este registro?"
        )


        if not confirmar:
            return


        try:


            values = self.tree.item(
                selection[0]
            )["values"]


            id_col = self.current_columns[0]


            query = (
                f"DELETE FROM {self.current_table} "
                f"WHERE {id_col} = %s"
            )


            self.db.execute_update(
                query,
                (values[0],)
            )


            messagebox.showinfo(
                "Éxito",
                "Registro eliminado correctamente"
            )


            self._refresh_data()


        except Error as e:


            messagebox.showerror(
                "Error",
                f"Error al eliminar:\n{e}"
            )


            self._update_status(
                f"Error: {str(e)}",
                "error"
            )


    # ========================================================
    # CERRAR APLICACIÓN
    # ========================================================


    def _on_closing(self):


        self.db.disconnect()


        self.root.destroy()




