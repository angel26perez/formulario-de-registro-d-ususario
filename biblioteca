        hsb = ttk.Scrollbar(
            parent,
            orient=tk.HORIZONTAL,
            command=self.tree.xview
        )


        hsb.pack(
            fill=tk.X
        )


        self.tree.configure(
            yscrollcommand=vsb.set,
            xscrollcommand=hsb.set
        )


        # Estilos
        style = ttk.Style()


        try:
            style.theme_use("clam")
        except tk.TclError:
            pass


        style.configure(
            "Treeview",
            background=self.COLORS["bg_lighter"],
            foreground=self.COLORS["text"],
            fieldbackground=self.COLORS["bg_lighter"],
            rowheight=30,
            borderwidth=0
        )


        style.configure(
            "Treeview.Heading",
            background=self.COLORS["accent"],
            foreground=self.COLORS["bg_dark"],
            font=("Segoe UI", 9, "bold"),
            borderwidth=1
        )


        style.map(
            "Treeview",
            background=[
                (
                    "selected",
                    self.COLORS["accent"]
                )
            ],
            foreground=[
                (
                    "selected",
                    self.COLORS["bg_dark"]
                )
            ]
        )


    def _fill_treeview(self):


        if not self.tree:
            return


        self.tree.delete(
            *self.tree.get_children()
        )


        self.tree["columns"] = (
            self.current_columns
        )


        self.tree["show"] = "headings"


        for col in self.current_columns:


            # Calcular ancho
            width = max(
                100,
                min(
                    250,
                    len(col) * 12
                )
            )


            self.tree.column(
                col,
                width=width,
                anchor=tk.CENTER
            )


            self.tree.heading(
                col,
                text=col.replace(
                    "_",
                    " "
                ).title()
            )


        # Insertar datos
        for row in self.current_data:


            self.tree.insert(
                "",
                tk.END,
                values=row
            )


